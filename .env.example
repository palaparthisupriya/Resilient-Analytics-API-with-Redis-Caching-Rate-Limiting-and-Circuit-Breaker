# --- Server Configuration ---
PORT=8000
NODE_ENV=development

# --- Redis Configuration ---
# Use 'redis' as the host if running inside Docker Compose
REDIS_HOST=redis
REDIS_PORT=6379

# --- Rate Limiting ---
# Requests allowed per window
RATE_LIMIT_MAX=5
# Window size in seconds
RATE_LIMIT_WINDOW=60

# --- Caching ---
# Time to live for cached metrics in seconds
CACHE_TTL=300

# --- Circuit Breaker ---
# Number of failures before tripping the circuit
CB_FAILURE_THRESHOLD=3
# Time to stay in OPEN state before trying again (ms)
CB_RESET_TIMEOUT=10000

# --- External Service Simulation ---
# Probability of failure (0.0 to 1.0)
EXTERNAL_SERVICE_FAILURE_RATE=0.5